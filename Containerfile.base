# syntax=docker/dockerfile:1
ARG PYTHON_IMAGE=python:3.14-slim-trixie
ARG NODE_IMAGE=node:24-trixie-slim
ARG FRAPPE_BUILD_IMAGE=frappe/build@sha256:0ea1392506828b8deec87c82788ca8936c3203848ecb93901194a5b506a7be46
FROM ${NODE_IMAGE} AS node
FROM ${PYTHON_IMAGE} AS os-backports
COPY --from=resolved lock.json /opt/build/lock.json
COPY scripts/os_backports.py scripts/python_expat.py /opt/build/
RUN python /opt/build/os_backports.py && python /opt/build/python_expat.py
FROM ${PYTHON_IMAGE} AS runtime-base
ENV PATH=/home/frappe/frappe-bench/env/bin:/usr/local/bin:${PATH} \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=resolved lock.json /opt/build/lock.json
COPY --from=os-backports /backports /opt/os-backports
RUN useradd -m -u 1000 -s /bin/bash frappe \
    && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends ca-certificates curl git nginx gettext-base \
       libpango-1.0-0 libharfbuzz0b libpangoft2-1.0-0 libpangocairo-1.0-0 \
       mariadb-client libmariadb3 libpq5 libmagic1 media-types tzdata-legacy \
       chromium-headless-shell libatk-bridge2.0-0 fonts-dejavu-core libnginx-mod-http-lua libnginx-mod-http-srcache-filter lua-cjson \
    && apt-get install -y --no-remove --no-install-recommends /opt/os-backports/*.deb \
    && apt-get purge -y chromium-headless-shell chromium-common \
    && dpkg --purge libperl5.40 perl-modules-5.40 \
    && rm -f /opt/os-backports/*.deb \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default \
    && sed -i '/user www-data/d' /etc/nginx/nginx.conf \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log \
    && touch /run/nginx.pid \
    && chown -R frappe:frappe /etc/nginx /var/log/nginx /var/lib/nginx /run/nginx.pid
COPY --from=resolved mariadb-keyring.asc /etc/apt/keyrings/mariadb-keyring.asc
RUN python -c 'import hashlib,json,re,subprocess; from pathlib import Path; p=json.load(open("/opt/build/lock.json"))["mariadb_client"]; assert p["repository"] == "https://deb.mariadb.org/11.8/debian"; assert re.fullmatch(r"1:11\.8\.\d+\+maria~deb13",p["version"]); assert hashlib.sha256(Path("/etc/apt/keyrings/mariadb-keyring.asc").read_bytes()).hexdigest() == p["key_sha256"]; Path("/etc/apt/sources.list.d/mariadb.list").write_text("deb [signed-by=/etc/apt/keyrings/mariadb-keyring.asc] "+p["repository"]+" trixie main\n"); subprocess.run(["apt-get","update"],check=True); subprocess.run(["apt-get","install","-y","--no-install-recommends"]+[name+"="+p["version"] for name in ("mariadb-client","mariadb-client-core","mariadb-common","libmariadb3")],check=True)' \
    && rm -rf /var/lib/apt/lists/*
RUN python -c 'import json,re,subprocess; from pathlib import Path; v=json.load(open("/opt/build/lock.json"))["curl_backport"]; assert re.fullmatch(r"\d+\.\d+\.\d+-\d+~bpo13\+\d+(?:\+b\d+)?",v); Path("/etc/apt/sources.list.d/backports.list").write_text("deb [signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] https://deb.debian.org/debian trixie-backports main\n"); subprocess.run(["apt-get","update"],check=True); subprocess.run(["apt-get","install","-y","--no-install-recommends","-t","trixie-backports"]+[name+"="+v for name in ("curl","libcurl3t64-gnutls","libcurl4-gnutls","libcurl4t64")],check=True)' \
    && rm -rf /var/lib/apt/lists/*

RUN python -c 'import json,shutil,sysconfig; from pathlib import Path; p=json.loads(Path("/opt/os-backports/pyexpat/provenance.json").read_text()); [shutil.copy2(Path("/opt/os-backports/pyexpat")/item["file"],Path(sysconfig.get_config_var("DESTSHARED"))/item["file"]) for item in p["binaries"].values()]' \
    && python -c 'import pyexpat,xml.etree.ElementTree as e; assert tuple(map(int,pyexpat.EXPAT_VERSION.split("_")[-1].split("."))) >= (2,10,0); assert e.fromstring("<root>ok</root>").text == "ok"'
COPY scripts/chromium.py /opt/build/chromium.py
RUN python /opt/build/chromium.py
COPY scripts/bootstrap.py resources/bootstrap.json /opt/bootstrap/
RUN python /opt/bootstrap/bootstrap.py runtime
USER frappe
LABEL org.opencontainers.image.source="https://github.com/modulairy/erpnext-container"
FROM ${FRAPPE_BUILD_IMAGE} AS builder-base
USER root
ARG YARN_VERSION
COPY --from=resolved lock.json /opt/build/lock.json
COPY --from=os-backports /backports /opt/os-backports
COPY --from=os-backports /build-deps /opt/os-build-deps
COPY --from=runtime-base /etc/apt/keyrings/mariadb-keyring.asc /etc/apt/keyrings/mariadb-keyring.asc
COPY --from=runtime-base /etc/apt/sources.list.d/mariadb.list /etc/apt/sources.list.d/mariadb.list
RUN python -c 'import json,platform,subprocess; from pathlib import Path; p=json.loads(Path("/opt/build/lock.json").read_text()); assert platform.python_version() == p["python"]; assert subprocess.check_output(["node","--version"],text=True).strip() == "v"+p["node"]' \
    && pip install --no-cache-dir packaging==26.3
RUN apt-get update \
    && set -- /opt/os-backports/*.deb /opt/os-build-deps/*.deb libpq-dev \
       libffi-dev liblcms2-dev libldap2-dev libsasl2-dev libtiff-dev \
       libwebp-dev libbz2-dev libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev libatk-bridge2.0-0 \
       systemd- systemd-standalone-sysusers \
    && plan="$(apt-get --simulate --no-install-recommends install "$@")" \
    && test "$(printf '%s\n' "$plan" | awk '/^Remv / {print $2}')" = systemd \
    && apt-get install -y --no-install-recommends "$@" \
    && dpkg --purge libperl5.40 perl-modules-5.40 \
    && python -c 'import json,subprocess; p=json.load(open("/opt/build/lock.json"))["mariadb_client"]; subprocess.run(["apt-get","install","-y","--no-install-recommends"]+[name+"="+p["version"] for name in ("libmariadb-dev","mariadb-client","mariadb-client-core","mariadb-common","libmariadb3")],check=True)' \
    && rm -f /opt/os-backports/*.deb \
    && rm -rf /var/lib/apt/lists/* /opt/os-build-deps
RUN python -c 'import json,shutil,sysconfig; from pathlib import Path; p=json.loads(Path("/opt/os-backports/pyexpat/provenance.json").read_text()); [shutil.copy2(Path("/opt/os-backports/pyexpat")/item["file"],Path(sysconfig.get_config_var("DESTSHARED"))/item["file"]) for item in p["binaries"].values()]'
COPY --from=runtime-base /opt/chromium /opt/chromium
RUN apt-get purge -y chromium-headless-shell chromium-common wkhtmltox \
    && ln -sf /opt/chromium/chrome-headless-shell-linux64/chrome-headless-shell /usr/bin/chromium-headless-shell \
    && test "$(yarn --version)" = "${YARN_VERSION}"
COPY scripts/bootstrap.py resources/bootstrap.json /opt/bootstrap/
RUN python /opt/bootstrap/bootstrap.py builder
USER frappe

